{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "DSH Desktop — DeepSeek Harness 桌面管理控制台（多 Tab：Harness / Plugin / MCP / Skills）",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "build": "tsc -p tsconfig.json && node scripts/build-preload.mjs && tsc -p tsconfig.renderer.json && node scripts/copy-renderer.mjs",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "smoke:harness": "electron . --harness-smoke",
    "verify:m1": "node scripts/verify-m1.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "yaml": "^2.9.0"
  }
}
