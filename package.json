{
  "name": "dsh-desktop-hub",
  "version": "0.1.0",
  "productName": "DSH Desktop Hub",
  "description": "DSH Desktop Hub — DeepSeek Harness 桌面管理控制台（多 Tab：Harness / Plugin / MCP / Skills）",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlashingChen/dsh-desktop-hub.git"
  },
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "build": "tsc -p tsconfig.json && node scripts/build-preload.mjs && tsc -p tsconfig.renderer.json && node scripts/copy-renderer.mjs",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "smoke:plugin": "npm run build && node scripts/smoke-plugin-remove.mjs",
    "smoke:harness": "electron . --harness-smoke",
    "verify:m1": "node scripts/verify-m1.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "yaml": "^2.9.0"
  }
}
